HOST=127.0.0.1
PORT=8000
DEV=false
# Time zone for timestamps shown in the dashboard (IANA tz name, e.g. Europe/Rome).
# Data stays stored as UTC epoch internally — TZ only affects the display.
TZ=UTC

AUTH_SECURE_COOKIE=0
TRUSTED_PROXIES=127.0.0.1

# Optional bearer tokens for API endpoints outside /ui (comma-separated). Empty = open (local use only).
API_TOKENS=

# Rate limit on the API endpoints (slowapi syntax, e.g. "20/minute"). Hot-reloadable
# (read by ConfigManager on every request, no restart needed to change it).
RATE_LIMIT=20/minute

# Dashboard panel auto-refresh — runtime-editable from the Config page (hot-reload).
REFRESH_ENABLED=true
REFRESH_INTERVAL=5
