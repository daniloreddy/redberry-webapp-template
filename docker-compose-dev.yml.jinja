services:
  {{ app_slug }}:
    build: .
    container_name: {{ app_slug | replace('_', '-') }}-dev
    restart: "no"
    ports:
      - "${PORT:-{{ default_port }}}:${PORT:-{{ default_port }}}"
    environment:
      - PYTHONUNBUFFERED=1
      - TZ=${TZ:-UTC}
      - PORT=${PORT:-{{ default_port }}}
      - ENV_FILE=/app/hostcfg/.env
    volumes:
      - .:/app/hostcfg
      - ./data:/app/data
