from __future__ import annotations

import time

from fastapi import Depends, Request
from redberry_webkit.bootstrap import run
from redberry_webkit.metrics import MetricsRecord
from redberry_webkit.request_view import request_meta

from app.core import web
from app.libs.example import greet
from app.ui.pages import router as pages_router

app = web.app
app.include_router(pages_router)


@app.get("/api/v1/example")
@web.limiter.limit(lambda: web.config.get("RATE_LIMIT", "20/minute"))
async def example_endpoint(
    request: Request, name: str = "world", token: str | None = Depends(web.verify_api_token)
) -> dict[str, str]:
    """Placeholder endpoint — replace with the project's real API, keep the rate-limit
    decorator and the Depends(web.verify_api_token) pattern."""
    start = time.monotonic()
    host = request.client.host if request.client else "unknown"
    ip, user_agent = request_meta(request.headers, host, web.trusted_proxies)
    extra = {"client_ip": ip, "user_agent": user_agent}
    try:
        message = greet(name)
    except Exception as exc:  # placeholder: replace with the project's real error handling
        await web.metrics.record(
            MetricsRecord(
                timestamp=time.time(),
                status="error",
                duration_s=time.monotonic() - start,
                error_message=str(exc),
                extra=extra,
            )
        )
        raise
    await web.metrics.record(
        MetricsRecord(timestamp=time.time(), status="ok", duration_s=time.monotonic() - start, extra=extra)
    )
    return {"message": message}


if __name__ == "__main__":
    run("app.main:app", web)
