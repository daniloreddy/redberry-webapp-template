from __future__ import annotations

import os
import re
from datetime import datetime

from fastapi import APIRouter, Request
from fastapi.responses import HTMLResponse, RedirectResponse, Response
from markupsafe import Markup
from redberry_webkit.request_view import RequestRow, request_rows_from_metrics
from redberry_webkit.timezone_utils import resolve_timezone
from redberry_webkit.web import ASSET_CACHE_CONTROL, parse_config_form, status_badge

from app.config import config
from app.metrics import metrics
from app.ui.layout import CONFIG_FIELDS, layout

DISPLAY_TZ = resolve_timezone(os.getenv("TZ", "UTC"))

_RATE_LIMIT_RE = re.compile(r"^\d+/(second|minute|hour|day)$")

router = APIRouter(prefix="/ui")


def _asset_response(name: str) -> Response:
    asset = layout.asset(name)
    if asset is None:
        return Response(status_code=404)
    data, content_type = asset
    return Response(data, media_type=content_type, headers={"Cache-Control": ASSET_CACHE_CONTROL})


# Explicit routes, not a /{name} wildcard: router routes win over the /ui/_assets StaticFiles mount
# (registered later in main.py) and must not shadow app.css. Both are gate-exempt via /ui/_assets.
@router.get("/_assets/favicon")
async def favicon() -> Response:
    return _asset_response("favicon")


@router.get("/_assets/logo")
async def logo() -> Response:
    return _asset_response("logo")


def _card(label: str, value: str, tone: str = "primary") -> Markup:
    return Markup('<div class="card"><div class="card-label">{}</div><div class="card-value {}">{}</div></div>').format(
        label, tone, value
    )


def _row(r: RequestRow) -> Markup:
    return Markup(
        "<tr><td>{}</td><td>{}</td><td>{}</td><td>{}</td><td>{}</td>"
        '<td class="ua" title="{}">{}</td></tr>'
    ).format(
        r.timestamp,
        r.ip or "—",
        r.error_message,
        r.duration_s,
        status_badge(r.status, r.error_message),
        r.user_agent,
        r.user_agent or "—",
    )


async def _live_fragment() -> Markup:
    """Metric cards + request table + the auto-refresh status label (the content of `#live`)."""
    stats = await metrics.get_stats()
    errors = stats["error_requests"]
    cards = Markup("").join(
        [
            _card("Richieste totali", str(stats["total_requests"])),
            _card("Richieste ok", str(stats["ok_requests"]), "positive"),
            _card("Errori", str(errors), "negative" if errors else "primary"),
            _card("Durata media (s)", f"{stats['avg_duration_s']:.2f}", "info"),
        ]
    )
    rows = Markup("").join(_row(r) for r in request_rows_from_metrics(await metrics.get_history(), DISPLAY_TZ))
    if config.get_bool("REFRESH_ENABLED"):
        now = datetime.now(DISPLAY_TZ).strftime("%H:%M:%S")
        label = f"Aggiornato: {now} · auto-refresh {config.get_int('REFRESH_INTERVAL', 5)}s"
    else:
        label = "auto-refresh disabilitato"
    return Markup(
        '<div class="cards">{}</div>'
        '<div class="wk-table-wrap"><table class="rb-table"><thead><tr>'
        "<th>TimeStamp</th><th>IP</th><th>Errore</th><th>Durata (s)</th><th>Stato</th><th>User Agent</th>"
        "</tr></thead><tbody>{}</tbody></table></div>"
        '<label class="refresh-lbl">{}</label>'
    ).format(cards, rows, label)


@router.get("/", response_class=HTMLResponse)
async def dashboard() -> str:
    polling = Markup("")
    if config.get_bool("REFRESH_ENABLED"):
        interval = max(1, config.get_int("REFRESH_INTERVAL", 5))
        polling = Markup(' hx-get="/ui/fragment/live" hx-trigger="every {}s" hx-swap="innerHTML"').format(interval)
    content = Markup('<div id="live"{}>{}</div>').format(polling, await _live_fragment())
    return layout.render_page("Dashboard", "Dashboard", content)


@router.get("/fragment/live", response_class=HTMLResponse)
async def live_fragment() -> str:
    return str(await _live_fragment())


def _render_config(banner: str = "", *, ok: bool = True, status_code: int = 200) -> HTMLResponse:
    html = layout.render_config(CONFIG_FIELDS, config.get_public(), banner=banner, banner_ok=ok)
    return HTMLResponse(html, status_code=status_code)


@router.get("/config", response_class=HTMLResponse)
async def config_page(result: str = "") -> HTMLResponse:
    return _render_config("Configurazione salvata" if result == "ok" else "")


@router.post("/config", response_model=None)
async def config_save(request: Request) -> HTMLResponse | RedirectResponse:
    form = {k: v for k, v in (await request.form()).items() if isinstance(v, str)}
    updates, error = parse_config_form(CONFIG_FIELDS, form)
    if not error and "REFRESH_INTERVAL" in updates and int(updates["REFRESH_INTERVAL"]) < 1:
        # An HTML min= attribute only constrains normal UI use, not a crafted POST.
        error = "Intervallo auto-refresh non valido (minimo 1s)"
    if not error and "RATE_LIMIT" in updates and not _RATE_LIMIT_RE.match(updates["RATE_LIMIT"]):
        error = "Rate limit non valido (formato atteso: 20/minute)"
    if error:
        return _render_config(error, ok=False, status_code=400)
    config.update_many(updates)
    return RedirectResponse(url="/ui/config?result=ok", status_code=303)
