from __future__ import annotations

from datetime import datetime

from fastapi import APIRouter
from fastapi.responses import HTMLResponse
from markupsafe import Markup
from redberry_webkit.request_view import RequestRow, request_rows_from_metrics
from redberry_webkit.web import status_badge

from app.core import web

router = APIRouter(prefix="/ui")


def _card(label: str, value: str, tone: str = "primary") -> Markup:
    return Markup('<div class="card"><div class="card-label">{}</div><div class="card-value {}">{}</div></div>').format(
        label, tone, value
    )


def _row(r: RequestRow) -> Markup:
    return Markup(
        "<tr><td>{}</td><td>{}</td><td>{}</td><td>{}</td><td>{}</td>"
        '<td class="ua" title="{}">{}</td></tr>'
    ).format(
        r.timestamp,
        r.ip or "—",
        r.error_message,
        r.duration_s,
        status_badge(r.status, r.error_message),
        r.user_agent,
        r.user_agent or "—",
    )


async def _live_fragment() -> Markup:
    """Metric cards + request table + the auto-refresh status label (the content of `#live`)."""
    stats = await web.metrics.get_stats()
    errors = stats["error_requests"]
    cards = Markup("").join(
        [
            _card("Richieste totali", str(stats["total_requests"])),
            _card("Richieste ok", str(stats["ok_requests"]), "positive"),
            _card("Errori", str(errors), "negative" if errors else "primary"),
            _card("Durata media (s)", f"{stats['avg_duration_s']:.2f}", "info"),
        ]
    )
    rows = Markup("").join(_row(r) for r in request_rows_from_metrics(await web.metrics.get_history(), web.display_tz))
    if web.config.get_bool("REFRESH_ENABLED"):
        now = datetime.now(web.display_tz).strftime("%H:%M:%S")
        label = f"Aggiornato: {now} · auto-refresh {web.config.get_int('REFRESH_INTERVAL', 5)}s"
    else:
        label = "auto-refresh disabilitato"
    return Markup(
        '<div class="cards">{}</div>'
        '<div class="wk-table-wrap"><table class="rb-table"><thead><tr>'
        "<th>TimeStamp</th><th>IP</th><th>Errore</th><th>Durata (s)</th><th>Stato</th><th>User Agent</th>"
        "</tr></thead><tbody>{}</tbody></table></div>"
        '<label class="refresh-lbl">{}</label>'
    ).format(cards, rows, label)


@router.get("/", response_class=HTMLResponse)
async def dashboard() -> str:
    polling = Markup("")
    if web.config.get_bool("REFRESH_ENABLED"):
        interval = max(1, web.config.get_int("REFRESH_INTERVAL", 5))
        polling = Markup(' hx-get="/ui/fragment/live" hx-trigger="every {}s" hx-swap="innerHTML"').format(interval)
    content = Markup('<div id="live"{}>{}</div>').format(polling, await _live_fragment())
    return web.layout.render_page("Dashboard", "Dashboard", content)


@router.get("/fragment/live", response_class=HTMLResponse)
async def live_fragment() -> str:
    return str(await _live_fragment())
