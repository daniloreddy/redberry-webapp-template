from __future__ import annotations

import os
import re
from datetime import datetime

from nicegui import ui
from redberry_webkit.request_view import REQUEST_TABLE_BASE_COLUMNS, STATUS_CELL_SLOT, request_rows_from_metrics
from redberry_webkit.timezone_utils import resolve_timezone
from redberry_webkit.ui import NavItem, metric_card, page

from app.config import config
from app.metrics import metrics

APP_NAME = "{{ app_name }}"
DISPLAY_TZ = resolve_timezone(os.getenv("TZ", "UTC"))

_RATE_LIMIT_RE = re.compile(r"^\d+/(second|minute|hour|day)$")

NAV_ITEMS: list[NavItem] = [
    NavItem("Dashboard", "dashboard", "/"),
    NavItem("Impostazioni", "settings", "/config"),
]


@ui.page("/")
async def dashboard_page() -> None:
    with page("Dashboard", app_name=APP_NAME, nav=NAV_ITEMS, current="Dashboard"), ui.column().classes(
        "q-pa-md full-width"
    ):
        metrics_row = ui.row().classes("full-width q-gutter-md")
        table_container = ui.column().classes("full-width")
        refresh_lbl = ui.label("").classes("text-caption text-grey-6").style("text-align:right; width:100%")

        async def _render() -> None:
            stats = await metrics.get_stats()
            metrics_row.clear()
            with metrics_row:
                metric_card("Richieste totali", str(stats["total_requests"]), "primary")
                metric_card("Richieste ok", str(stats["ok_requests"]), "positive")
                metric_card(
                    "Errori", str(stats["error_requests"]), "negative" if stats["error_requests"] else "primary"
                )
                metric_card("Durata media (s)", f"{stats['avg_duration_s']:.2f}", "info")

            history = await metrics.get_history()
            table_container.clear()
            with table_container:
                request_rows = request_rows_from_metrics(history, DISPLAY_TZ)
                rows = [
                    {
                        "id": r.id,
                        "timestamp": r.timestamp,
                        "ip": r.ip,
                        "error_message": r.error_message,
                        "duration_s": r.duration_s,
                        "status": r.status,
                        "user_agent": r.user_agent,
                    }
                    for r in request_rows
                ]
                timestamp_col, ip_col, duration_col, status_col, user_agent_col = REQUEST_TABLE_BASE_COLUMNS
                tbl = ui.table(
                    columns=[
                        timestamp_col,
                        ip_col,
                        {"name": "error_message", "label": "Errore", "field": "error_message"},
                        duration_col,
                        status_col,
                        user_agent_col,
                    ],
                    rows=rows,
                    row_key="id",
                ).classes("full-width")
                tbl.add_slot("body-cell-status", STATUS_CELL_SLOT)

            refresh_enabled = config.get_bool("REFRESH_ENABLED")
            interval = config.get_int("REFRESH_INTERVAL", 5)
            if refresh_enabled:
                now = datetime.now(DISPLAY_TZ).strftime("%H:%M:%S")
                refresh_lbl.set_text(f"Aggiornato: {now} · auto-refresh {interval}s")
            else:
                refresh_lbl.set_text("auto-refresh disabilitato")

        await _render()

        # 1s tick instead of a timer built from the interval at page-load time — so a
        # REFRESH_INTERVAL/REFRESH_ENABLED change saved from the Config page takes effect
        # on this already-open page without a manual reload.
        _elapsed_s = 0.0

        async def _tick() -> None:
            nonlocal _elapsed_s
            if not config.get_bool("REFRESH_ENABLED"):
                refresh_lbl.set_text("auto-refresh disabilitato")
                return
            _elapsed_s += 1.0
            if _elapsed_s >= config.get_int("REFRESH_INTERVAL", 5):
                _elapsed_s = 0.0
                await _render()

        ui.timer(1.0, _tick)


@ui.page("/config")
def config_page() -> None:
    with page("Impostazioni", app_name=APP_NAME, nav=NAV_ITEMS, current="Impostazioni"), ui.column().classes(
        "q-pa-md full-width"
    ):
        cur = config.get_public()

        with ui.card().classes("q-pa-md full-width"):
            ui.label("Interfaccia").classes("text-caption text-grey-6 text-uppercase")
            refresh_switch = ui.switch(
                "Auto-refresh dashboard", value=cur.get("REFRESH_ENABLED", "true").lower() in ("true", "1", "yes")
            )
            ui.badge("hot-reload").props("color=positive")
            interval_input = ui.number(
                "Intervallo auto-refresh (s)", value=int(cur.get("REFRESH_INTERVAL", "5") or 5), min=1
            ).classes("full-width")

        with ui.card().classes("q-pa-md full-width"):
            ui.label("API").classes("text-caption text-grey-6 text-uppercase")
            rate_limit_input = ui.input("Rate limit (slowapi, es. 20/minute)", value=cur.get("RATE_LIMIT", "")).props(
                'hint="Applicato ad ogni richiesta, hot-reload senza restart"'
            ).classes("full-width")

        # Un progetto derivato aggiunge qui altre card/campi per le proprie chiavi
        # di config estese (vedi app/config.py), seguendo lo stesso pattern sopra:
        # leggere da cur.get(...), scrivere via config.update_many({...}) al salvataggio.

        def _save() -> None:
            rate_limit = rate_limit_input.value.strip()
            if not _RATE_LIMIT_RE.match(rate_limit):
                ui.notify("Rate limit non valido (formato atteso: 20/minute)", color="negative")
                return
            interval = int(interval_input.value or 5)
            if interval < 1:
                # ui.number(min=1) only constrains normal UI interaction, not a request
                # crafted directly against the endpoint — without this, a negative value
                # survives (0 is falsy so it coerces to the 5 default, but e.g. -3 doesn't)
                # and _tick()'s `_elapsed_s >= REFRESH_INTERVAL` is then always true, making
                # the dashboard refresh every second regardless of the configured value.
                ui.notify("Intervallo auto-refresh non valido (minimo 1s)", color="negative")
                return
            config.update_many(
                {
                    "REFRESH_ENABLED": "true" if refresh_switch.value else "false",
                    "REFRESH_INTERVAL": str(interval),
                    "RATE_LIMIT": rate_limit,
                }
            )
            ui.notify("Configurazione salvata", color="positive")

        ui.button("Salva", on_click=_save).props("color=primary")
